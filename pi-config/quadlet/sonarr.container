[Unit]
Description=Sonarr
Wants=network-online.target
After=network-online.target

[Container]
AutoUpdate=registry
Image=docker.io/linuxserver/sonarr:4.0.19.2979-ls321
ContainerName=sonarr
Network=host
DNS=127.0.0.1
Environment=PUID=1000
Environment=PGID=1000
Environment=TZ=Asia/Kolkata
Environment=DOTNET_SYSTEM_NET_DISABLEIPV6=true
Volume=/home/onkar/media-stack/config/sonarr:/config
Volume=/home/onkar/media-stack/downloads:/downloads
Volume=/home/onkar/media-stack/media/tv:/tv

[Service]
Restart=always

[Install]
WantedBy=default.target
